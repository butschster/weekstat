      "html": "<div class=\"ds-legs\"><div class=\"ds-leg\"><div class=\"ds-d\">Fri <b>25</b> Sep</div><div class=\"ds-bar\"><i style=\"width:62%\"></i><s></s></div><div class=\"ds-lv\">17.6<span class=\"ds-u\">%</span></div><div class=\"ds-sh\">49% of wk</div></div><div class=\"ds-leg ds-today\"><div class=\"ds-d\">Today <b>28</b> Sep</div><div class=\"ds-bar\"><i style=\"width:8%\"></i><s></s></div><div class=\"ds-lv\">2.4<span class=\"ds-u\">%</span></div><div class=\"ds-sh\">7% of wk</div></div><div class=\"ds-leg ds-ahead\"><div class=\"ds-d\">Tue <b>29</b> Sep</div><div class=\"ds-bar\"><s></s></div><div class=\"ds-lv\">—</div></div></div>",
      "css": ".ds-legs{display:flex;border-top:1px solid #1F2B37;background:#0F1720;font-family:system-ui,sans-serif;width:360px;} .ds-leg{flex:1;padding:9px 6px 6px;border-left:1px solid #223040;} .ds-leg:first-child{border-left-color:transparent;} .ds-d{font-size:12px;color:#A9B8C6;white-space:nowrap;} .ds-d b{font-family:ui-monospace,Menlo,monospace;font-weight:500;color:#E6EDF3;} .ds-bar{position:relative;height:5px;margin:8px 0 7px;background:#1A2530;border-radius:1px;} .ds-bar i{position:absolute;left:0;top:0;bottom:0;border-radius:1px;background:#34E0A1;} .ds-bar s{position:absolute;top:-3px;bottom:-3px;left:50%;width:1.5px;background:#FF4FD8;} .ds-lv{font:500 13px ui-monospace,Menlo,monospace;font-variant-numeric:tabular-nums;color:#E6EDF3;} .ds-u{color:#7C8EA0;font-size:.78em;} .ds-sh{font-size:12px;color:#7C8EA0;} .ds-today{background:color-mix(in srgb,#3FD0FF 6%,transparent);box-shadow:inset 0 2px 0 #3FD0FF;} .ds-today .ds-d{color:#3FD0FF;} .ds-ahead .ds-d,.ds-ahead .ds-lv{color:#7C8EA0;} .ds-ahead .ds-bar{background:none;border:1px dashed #263444;}"
